# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Leave empty to run without accounts (progress stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in button (public): Google Cloud > Google Auth Platform > Clients.
# Leave empty to use the redirect-based Google sign-in instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile "are you human?" check (public site key): Cloudflare > Turnstile.
# The secret key goes only in Supabase > Authentication > Attack Protection.
# Leave empty to skip the check (and keep CAPTCHA off in Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
